# Comma-separated key pool (at least 2). Ids are key_1, key_2, ... in this order.
LLM_API_KEYS=your-gemini-key-1,your-gemini-key-2
LLM_MODEL=gemini/gemini-2.0-flash
DATABASE_URL=sqlite:////data/app.db
ALLOWED_ORIGINS=http://localhost:3000
ENABLE_FAILURE_SIMULATION=true
# local (in-memory) or disk (persists under CACHE_DIR)
CACHE_TYPE=local
CACHE_DIR=/data/llm_cache
LLM_TIMEOUT=30
DEFAULT_SYSTEM_PROMPT=You are a helpful, concise assistant.
# Frontend build-time: public URL of the backend
VITE_API_URL=http://localhost:8000
# Offline demo mode (no real LLM calls); keep false in production
LLM_MOCK=false
